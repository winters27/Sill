{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sill",
  "version": "0.1.0",
  "identifier": "app.winters.sill",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1425",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sill",
        "width": 750,
        "height": 500,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true,
        "shadow": true,
        "closable": false,
        "minimizable": false,
        "maximizable": false
      },
      {
        "label": "dictation",
        "title": "Dictation",
        "url": "dictation",
        "width": 240,
        "height": 84,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "closable": false,
        "minimizable": false,
        "maximizable": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/sounds/*"
    ]
  }
}
