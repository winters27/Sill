{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sill",
  "version": "../package.json",
  "identifier": "app.winters.sill",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1425",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sill",
        "width": 750,
        "height": 500,
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true,
        "shadow": true,
        "closable": false,
        "minimizable": false,
        "maximizable": false
      },
      {
        "label": "traymenu",
        "title": "Sill menu",
        "url": "traymenu",
        "width": 216,
        "height": 206,
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true,
        "closable": false,
        "minimizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: asset: http://asset.localhost https:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: ws: http: https: ipc: asset:"
    }
  },
  "bundle": {
    "active": true,
    "windows": {
      "nsis": {
        "installerHooks": "./installer/hooks.nsh"
      }
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/sounds/*": "resources/sounds/",
      "../host/dist/host.js": "host/host.js",
      "../host/node_modules/@esbuild/win32-x64/esbuild.exe": "esbuild/esbuild.exe"
    }
  }
}
