{
  "name": "sill",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/fetch-fonts.mjs --required && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "host:build": "npm --prefix host run build",
    "host:test": "npm --prefix host test",
    "fonts": "node scripts/fetch-fonts.mjs",
    "postinstall": "node scripts/fetch-fonts.mjs",
    "verify:tree": "node scripts/verify-tree.mjs",
    "verify:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "verify": "npm run host:test && npm run check && npm run verify:web && npm run verify:rust && npm run verify:source && npm run verify:tree && npm run gate:views",
    "gate:views": "bash scripts/gate-views.sh",
    "verify:source": "node scripts/verify-source.mjs",
    "verify:web": "vitest run --reporter=dot"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
