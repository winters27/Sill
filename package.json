{
  "name": "sill",
  "version": "0.1.5",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/fetch-fonts.mjs --required && node scripts/fetch-node.mjs --required && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "host:build": "npm --prefix host run build",
    "host:test": "npm --prefix host test",
    "fonts": "node scripts/fetch-fonts.mjs",
    "node:fetch": "node scripts/fetch-node.mjs",
    "postinstall": "node scripts/fetch-fonts.mjs && node scripts/fetch-node.mjs",
    "verify:tree": "node scripts/verify-tree.mjs",
    "verify:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "verify:rust:fast": "cargo check --manifest-path src-tauri/Cargo.toml --all-targets && cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "verify": "npm run host:test && npm run check && npm run verify:web && npm run verify:rust && npm run verify:source && npm run verify:page && npm run verify:tree && npm run gate:views",
    "gate:views": "bash scripts/gate-views.sh",
    "extensions:fetch": "node scripts/fetch-raycast-src.mjs",
    "verify:source": "node scripts/verify-source.mjs",
    "verify:page": "node scripts/benchmark-page.mjs --check",
    "benchmark": "node scripts/benchmark-page.mjs",
    "benchmark:take": "node scripts/measure-checks.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "changelog": "node scripts/changelog.mjs",
    "version:set": "node scripts/set-version.mjs",
    "verify:web": "vitest run --reporter=dot",
    "release": "node scripts/release.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "22.10.2",
    "happy-dom": "^20.14.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
