.DS_Store
node_modules
/build
/.svelte-kit
/package
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Extension working area: a sparse checkout of raycast/extensions and the
# bundles built from it. Both are reproducible from scripts, and the checkout
# alone is hundreds of megabytes.
/extensions/raycast-src/
/extensions/build/

# Bundled extension host output.
/host/dist/
/host/node_modules/

# The Node runtime the bundle ships for extensions. Fetched per machine by
# scripts/fetch-node.mjs, pinned by version and checksum there.
/src-tauri/resources/node/

# `tauri icon` regenerates every platform's icon set from `master.png`, Android
# and iOS trees and a macOS `.icns` included. Sill is a Win32 application and
# runs on none of them, so those are not kept, and `bundle.icon` in
# `tauri.conf.json` no longer names the `.icns`. Ignored rather than only
# deleted, because the next person to regenerate icons would commit them back.
/src-tauri/icons/android/
/src-tauri/icons/ios/
/src-tauri/icons/icon.icns

# The interface font. Satoshi is under the ITF Free Font License, which lets
# this application embed it but forbids offering the file itself through a
# "repository" or "publicly accessible servers". `npm run fonts` fetches it
# per machine, direct from Fontshare, which is the arrangement that licence
# describes. `verify:source` fails if a font is ever tracked again.
/src/lib/theme/fonts/*.woff2

# A second Cargo target directory, used to build and test while a release
# build of Sill is running and holding a lock on the first one. Cargo writes a
# `.gitignore` of its own inside `target`, which is why that one never needed
# a line here, and it does not do the same for a directory named by
# `CARGO_TARGET_DIR`. Nine thousand build artefacts were committed before this
# line existed.
/src-tauri/target-audit/
/target-audit/

# Worktrees Claude Code creates for parallel agents. Each holds its own
# node_modules and Cargo target, so one `git add -A` without this line would
# commit tens of thousands of build artefacts.
/.claude/worktrees/

# Raw screen captures. `scripts/shoot.ps1` writes them and
# `scripts/shoot-compose.py` turns them into the pictures the README shows,
# which are what gets committed. The backdrop is generated, not kept.
docs/media/raw/
